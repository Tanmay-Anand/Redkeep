# Runtime environment passed INTO the target services (docker-compose env_file).
# Copy to lab/target/.env (gitignored).
#
# For compose build-context paths (TARGET_*_PATH) and the lab DB credentials, see
# lab/.env.example instead — those are interpolated at parse time and belong there.
#
# Point the services at the lab database and disable outbound integrations so
# the target stays isolated. These names are examples — adjust them to match the
# target app's actual env vars (framework-specific, e.g. SPRING_DATASOURCE_*,
# DATABASE_URL, etc.).
DATABASE_URL=postgresql://target-db:5432/app
DATABASE_USER=app
DATABASE_PASSWORD=throwaway-lab-only

# Disable outbound integrations (payment, SMS, email, webhooks) in the lab:
INTEGRATIONS_ENABLED=false
