# Runtime environment passed INTO the CRM target services (docker-compose
# env_file). Copy to lab/target/.env (gitignored).
#
# For compose build-context paths (CRM_*_PATH) and the lab DB credentials, see
# lab/.env.example instead — those are interpolated at parse time and belong there.
#
# Point the services at the lab database and disable outbound integrations so
# the target stays isolated. Adjust names to match the CRM's actual env vars.
SPRING_DATASOURCE_URL=jdbc:postgresql://target-db:5432/crm
SPRING_DATASOURCE_USERNAME=crm
SPRING_DATASOURCE_PASSWORD=throwaway-lab-only

# Disable outbound integrations (payment, SMS, email, webhooks) in the lab:
INTEGRATIONS_ENABLED=false
