# Compose-level variables for `docker compose -f lab/docker-compose.yml`.
# These are interpolated when the compose file is PARSED, so they must live here
# (auto-loaded from lab/.env) — not in lab/target/.env, which is only the
# services' runtime env_file. Copy this to lab/.env (gitignored).
#
# Build-context paths to the real CRM repos — referenced READ-ONLY as Docker
# build contexts. Point each at the repo root containing that service's Dockerfile.
CRM_API_PATH=D:/work/Builder-CRM/builder-crm-api
CRM_PLATFORM_PATH=../path/to/crm-platform
CRM_POST_SALES_PATH=../path/to/crm-post-sales
CRM_REPORTS_API_PATH=../path/to/crm-reports-api
CRM_UI_PATH=../path/to/crm-ui

# Throwaway Postgres credentials for the lab DB (never real).
DB_USER=crm
DB_PASSWORD=throwaway-lab-only
DB_NAME=crm
