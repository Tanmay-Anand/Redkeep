# Compose-level variables for `docker compose -f lab/docker-compose.yml`.
# These are interpolated when the compose file is PARSED, so they must live here
# (auto-loaded from lab/.env) — not in lab/target/.env, which is only the
# services' runtime env_file. Copy this to lab/.env (gitignored).
#
# Build-context paths to the real target-app repos — referenced READ-ONLY as
# Docker build contexts. Point each at the repo root containing that service's
# Dockerfile.
TARGET_API_PATH=../path/to/app-api
TARGET_PLATFORM_PATH=../path/to/app-platform
TARGET_ADMIN_PATH=../path/to/app-admin
TARGET_REPORTS_PATH=../path/to/app-reports
TARGET_UI_PATH=../path/to/app-ui

# Throwaway Postgres credentials for the lab DB (never real).
DB_USER=app
DB_PASSWORD=throwaway-lab-only
DB_NAME=app
