<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Redkeep report: {{ product }}</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml;base64,">
<style>
  {% if font_woff2_b64 %}
  @font-face{font-family:'Inter';font-style:normal;font-weight:100 900;
    font-display:swap;src:url(data:font/woff2;base64,{{ font_woff2_b64 }}) format('woff2')}
  {% endif %}
  {% for w, b64 in (mono_fonts_b64 or {}).items() %}
  @font-face{font-family:'JetBrains Mono';font-style:normal;font-weight:{{ w }};
    font-display:swap;src:url(data:font/woff2;base64,{{ b64 }}) format('woff2')}
  {% endfor %}
  :root{
    /* Light surface tokens — shared with the launcher (Keep). Light only; the keep's dark
       tokens are not used here: the report has no live output. */
    color-scheme:light;
    --bg:#f6f6f5; --panel:#ffffff; --card:#fbfbfa; --ink:#111113; --muted:#60636b;
    --line:#e2e2de; --line2:#eeeeeb; --soft:#b9bbc1;
    --hatch:repeating-linear-gradient(135deg, rgba(17,17,19,.14) 0 1px, transparent 1px 6px);
    /* Severity scale (CVSS v3.1 bands). */
    --crit:#b4232a; --high:#c0461f; --med:#d99400; --low:#2f6fa8; --info:#6b7280;
    --font-sans:'Inter',system-ui,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
    --font-mono:'JetBrains Mono',ui-monospace,'SF Mono',Consolas,monospace;
  }
  *{box-sizing:border-box}
  [hidden]{display:none!important}
  body{margin:0;background:var(--bg);color:var(--ink);-webkit-font-smoothing:antialiased;
    font:14.5px/1.55 var(--font-sans);padding:44px 20px 70px;
    -webkit-print-color-adjust:exact;print-color-adjust:exact}
  .wrap{max-width:980px;margin:0 auto}

  /* Two voices: mono for what the machine says, Inter for what people read. */
  .lbl{font:500 11.5px/1.2 var(--font-mono);color:var(--muted);letter-spacing:.01em}
  .lbl b{color:var(--ink);font-weight:700}
  code{font:12px var(--font-mono);background:var(--line2);padding:1px 5px;overflow-wrap:anywhere}

  /* Back to the launcher — shown only when the launcher served this file (see script below). */
  .back{display:inline-flex;align-items:center;gap:6px;margin:0 0 22px;font:500 12px/1 var(--font-mono);
    color:var(--ink);text-decoration:underline;text-decoration-color:var(--soft);text-underline-offset:4px}
  .back:hover{text-decoration-color:var(--ink)}
  .back svg{flex:none}
  :focus-visible{outline:2px solid var(--ink);outline-offset:2px}
  @media print{.back{display:none!important}}

  .head{display:flex;align-items:center;gap:12px;margin-bottom:10px}
  .head svg{flex:none}
  h1{font-size:23px;margin:0;font-weight:700;letter-spacing:-.02em;line-height:1.25}
  .meta{display:flex;flex-wrap:wrap;gap:6px 22px;margin:0 0 26px}

  .panel{background:var(--panel);border:1px solid var(--line);margin-bottom:18px}
  .ph{display:flex;align-items:baseline;justify-content:space-between;gap:12px;
    padding:16px 20px;border-bottom:1px solid var(--line)}

  /* Severity strip: five cells divided by hairlines, a mark over a number. */
  .strip{display:grid;grid-template-columns:repeat(5,minmax(0,1fr))}
  .cell{padding:16px 20px 18px;border-right:1px solid var(--line2)}
  .cell:last-child{border-right:0}
  .num{display:block;margin-top:12px;font:700 32px/1.1 var(--font-mono);letter-spacing:-.03em;
    font-variant-numeric:tabular-nums}
  .num.z{color:var(--muted);font-weight:400}
  .num.c{color:var(--crit)} .num.h{color:var(--high)}

  /* Severity mark — 3px colour bar + uppercase code (the only uppercase in the system). */
  .s-crit{--c:var(--crit)} .s-high{--c:var(--high)} .s-med{--c:var(--med)}
  .s-low{--c:var(--low)} .s-info{--c:var(--info)}
  .sev{display:inline-flex;align-items:center;gap:8px;font:500 11.5px/1 var(--font-mono);
    letter-spacing:.05em;color:var(--ink);white-space:nowrap}
  .sev::before{content:"";width:3px;height:13px;background:var(--c,transparent);flex:none}

  /* Findings table. */
  .scroll{overflow-x:auto}
  table{width:100%;border-collapse:collapse;min-width:640px}
  th{font:500 11.5px/1.2 var(--font-mono);color:var(--muted);letter-spacing:.01em;text-align:left;
    padding:12px;border-bottom:1px solid var(--line)}
  td{padding:14px 12px;border-bottom:1px solid var(--line2);vertical-align:top;font-size:14px}
  th:first-child,td:first-child{padding-left:20px}
  th:last-child,td:last-child{padding-right:20px}
  tbody tr:last-child td{border-bottom:0}
  td.sevc{padding-top:17px}
  td.tool{font:12.5px/1.55 var(--font-mono);color:var(--muted);white-space:nowrap}
  th.n,td.n{text-align:right}
  td.n{font:700 13px/1.55 var(--font-mono);font-variant-numeric:tabular-nums}
  td.detail{font-size:13.5px;color:var(--muted)}

  /* Hatch = "nothing here". */
  .none{margin:20px;padding:14px 16px;border:1px solid var(--line);background:var(--hatch),var(--card);
    font:12.5px/1.6 var(--font-mono);color:var(--muted)}

  footer{color:var(--muted);font-size:12.5px;margin-top:28px;line-height:1.7}

  @media (max-width:640px){
    body{padding:28px 16px 56px}
    .strip{grid-template-columns:repeat(3,minmax(0,1fr))}
    .cell{border-bottom:1px solid var(--line2);padding:14px 16px}
    .cell:nth-child(3){border-right:0}
    .cell:nth-child(n+4){border-bottom:0}
    .num{font-size:26px}
    .ph{padding:14px 16px}
  }
</style>
</head>
<body>
{% set ABBR = {'Critical':'CRIT','High':'HIGH','Medium':'MED','Low':'LOW','Info':'INFO'} %}
{% set SEVCLS = {'Critical':'crit','High':'high','Medium':'med','Low':'low','Info':'info'} %}
<div class="wrap">
  <a class="back" id="back" href="/" hidden><svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M10 6H2M5.5 2.5 2 6l3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>back to launcher</a>
  <script>
    /* The same file is opened straight from disk too; only offer the link when the launcher serves it. */
    if (/^https?:$/.test(location.protocol) && location.pathname.indexOf('/report/') === 0) {
      document.getElementById('back').hidden = false;
    }
  </script>
  <div class="head">
    <svg viewBox="-7 -4 96 96" width="32" height="34" aria-label="Redkeep">
      <path d="M5 83 V5 H15 V19 H36 V5 H46 V19 H67 V5 H77 V83 H56 V60 A15 15 0 0 0 26 60 V83 Z"
            fill="none" style="stroke:var(--ink)" stroke-width="10" stroke-linejoin="miter"/>
    </svg>
    <h1>Redkeep VAPT report: {{ product }}</h1>
  </div>
  <p class="meta">
    <span class="lbl">engagement <b>{{ engagement }}</b></span>
    <span class="lbl">generated <b>{{ generated }}</b></span>
    <span class="lbl">source <code>{{ run_dir }}</code></span>
  </p>

  <section class="panel" aria-label="Findings by severity">
    <div class="strip">
      {% for sev in severity_order %}
      {% set n = summary[sev] %}
      <div class="cell">
        <span class="sev s-{{ SEVCLS[sev] }}">{{ ABBR[sev] }}</span>
        <span class="num{% if n == 0 %} z{% elif sev == 'Critical' %} c{% elif sev == 'High' %} h{% endif %}">{{ n }}</span>
      </div>
      {% endfor %}
    </div>
  </section>

  <section class="panel">
    <div class="ph">
      <span class="lbl">findings</span>
      <span class="lbl"><b>{{ findings|length }}</b> rows</span>
    </div>
    {% if findings %}
    <div class="scroll">
    <table>
      <thead>
        <tr><th>severity</th><th>finding</th><th>tool</th><th class="n">count</th><th>detail / reference</th></tr>
      </thead>
      <tbody>
        {% for f in findings %}
        <tr>
          <td class="sevc"><span class="sev s-{{ SEVCLS[f.severity] }}">{{ ABBR[f.severity] }}</span></td>
          <td>{{ f.name }}</td>
          <td class="tool">{{ f.tool }}</td>
          <td class="n">{{ f.count }}</td>
          <td class="detail">{{ f.detail }}{% if f.reference %} <code>{{ f.reference }}</code>{% endif %}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    </div>
    {% else %}
    <p class="none">No parsed findings in this run. Check the raw tool output in the run directory.</p>
    {% endif %}
  </section>

  <footer>
    Generated by Redkeep. Findings are aligned to OWASP WSTG, OWASP API Security Top 10,
    OWASP ASVS, PTES and NIST SP 800-115; severities use CVSS v3.1 bands.
    This report covers an authorised test of an isolated lab copy of the target only.
    Raw evidence (tool output) is in the run directory shown above.
  </footer>
</div>
</body>
</html>
